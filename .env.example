# Copy this file to .env and fill only the values you need.
# The real .env file is git-ignored and may contain secrets.

# Local Docker PostgreSQL defaults.
PARLAMENTO_DB_NAME=parlamento
PARLAMENTO_DB_USER=parlamento
PARLAMENTO_DB_PASSWORD=parlamento

# Optional AI summaries.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini-2024-07-18

# Optional Parliament Open Data overrides.
PARLIAMENT_OPEN_DATA_LATEST_LEGISLATURE=XVII
PARLIAMENT_OPEN_DATA_DAILY_IMPORT_ENABLED=false
PARLIAMENT_OPEN_DATA_DAILY_IMPORT_RUN_SUMMARIES=true

# To run the backend against Neon, set this in .env and use the neon Compose profile.
# PARLAMENTO_NEON_CONNECTION_STRING="Host=your-neon-pooler-host; Database=neondb; Username=neondb_owner; Password=your-password; SSL Mode=VerifyFull; Channel Binding=Require;"
